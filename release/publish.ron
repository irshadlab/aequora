(
    delay_seconds: 15,
    rate_limit_attempts: 3,
    rate_limit_wait_seconds: 600,
    propagation_retries: 8,
    crates: [
        "aequora",
        "aequora-adapter-sdk",
        "aequora-authority",
        "aequora-axum",
        "aequora-cli",
        "aequora-client",
        "aequora-codec",
        "aequora-compute",
        "aequora-config",
        "aequora-deployment",
        "aequora-desktop",
        "aequora-diagnostics",
        "aequora-http",
        "aequora-legacy-api",
        "aequora-live",
        "aequora-macros",
        "aequora-mobile",
        "aequora-observability",
        "aequora-profile",
        "aequora-protocol",
        "aequora-quic",
        "aequora-registry",
        "aequora-release",
        "aequora-security",
        "aequora-server",
        "aequora-store",
        "aequora-store-postgres",
        "aequora-store-sqlite",
        "aequora-store-stoolap",
        "aequora-supply-chain",
        "aequora-testkit",
        "aequora-types",
        "aequora-workload",
    ],
)
