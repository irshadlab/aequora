(
    schema_version: 1,
    layers: [
        (
            name: "foundation",
            crates: [
                "aequora-workload",
                "aequora-compute",
                "aequora-macros",
                "aequora-types",
            ],
        ),
        (
            name: "protocol-contracts",
            crates: [
                "aequora-authority",
                "aequora-codec",
                "aequora-observability",
                "aequora-protocol",
                "aequora-registry",
                "aequora-security",
            ],
        ),
        (
            name: "domain-execution",
            crates: [
                "aequora-release",
                "aequora-diagnostics",
                "aequora-supply-chain",
            ],
        ),
        (
            name: "storage-contracts",
            crates: [
                "aequora-adapter-sdk",
                "aequora-profile",
                "aequora-store",
            ],
        ),
        (
            name: "sync-engines",
            crates: [
                "aequora-client",
                "aequora-live",
                "aequora-server",
            ],
        ),
        (
            name: "physical-adapters",
            crates: [
                "aequora-store-postgres",
                "aequora-store-sqlite",
                "aequora-store-stoolap",
            ],
        ),
        (
            name: "integration-platform",
            crates: [
                "aequora-axum",
                "aequora-config",
                "aequora-deployment",
                "aequora-desktop",
                "aequora-http",
                "aequora-legacy-api",
                "aequora-mobile",
                "aequora-quic",
            ],
        ),
        (
            name: "applications",
            crates: [
                "aequora",
                "aequora-cli",
            ],
        ),
        (
            name: "tooling-verification",
            crates: [
                "xtask",
                "aequora-dev",
                "aequora-testkit",
            ],
        ),
    ],
    allowed_outward_edges: [
        (source: "aequora-cli", dependency: "aequora-testkit"),
    ],
    dependency_budgets: [
        (crate_name: "aequora-store", max_workspace: 8, max_external: 4),
        (crate_name: "aequora-types", max_workspace: 0, max_external: 3),
        (crate_name: "aequora-protocol", max_workspace: 1, max_external: 10),
        (crate_name: "aequora-client", max_workspace: 18, max_external: 3),
        (crate_name: "aequora-server", max_workspace: 26, max_external: 4),
        (crate_name: "aequora-axum", max_workspace: 10, max_external: 6),
    ],
    exclusive_dependencies: [
        (dependency: "dioxus", owners: []),
        (dependency: "sqlx", owners: ["aequora-store-postgres"]),
        (dependency: "stoolap", owners: ["aequora-store-stoolap"]),
        (dependency: "rusqlite", owners: ["aequora-store-sqlite"]),
        (dependency: "quinn", owners: ["aequora-quic"]),
        (dependency: "reqwest", owners: ["aequora", "aequora-http"]),
        (dependency: "axum", owners: ["aequora", "aequora-axum", "aequora-http"]),
        (dependency: "tower", owners: ["aequora-axum"]),
        (dependency: "jni", owners: ["aequora-mobile"]),
        (dependency: "windows-sys", owners: ["aequora-desktop"]),
        (dependency: "objc2", owners: ["aequora-desktop", "aequora-mobile"]),
        (dependency: "security-framework", owners: ["aequora-desktop", "aequora-mobile"]),
    ],
)
