[
    Match(pattern: r#"aequora_protocol::compat|aequora_protocol::\{[^}]*\bcompat\b"#, paths: ["crates/aequora-security/src"], forbidden: true),
    File("crates/aequora-security/Cargo.toml"),
    File("crates/aequora-security/src/lib.rs"),
    File("crates/aequora-testkit/tests/security_abuse_contracts.rs"),
    File("config/security.ron"),
    File("docs/security-threat-matrix.md"),
    File("docs/security-runbooks.md"),
    File("docs/security-ownership.md"),
    File("SECURITY.md"),
    Match(pattern: "AEQ-INV-SEC001", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-SEC001", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AEQ-INV-SEC002", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-SEC002", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AEQ-INV-SEC003", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-SEC003", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AEQ-INV-SEC004", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-SEC004", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AEQ-INV-SEC005", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-SEC005", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AEQ-INV-SEC006", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-SEC006", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AEQ-INV-SEC007", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-SEC007", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AEQ-INV-SEC008", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-SEC008", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AEQ-INV-SEC009", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-SEC009", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AEQ-INV-SEC010", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-SEC010", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "(^|[^[:alnum:]_-])(sqlx|stoolap|tokio|axum|reqwest|quinn)([^[:alnum:]_-]|$)", paths: ["crates/aequora-security/Cargo.toml"], forbidden: true),
    Match(pattern: "AuthenticationEvidence", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AuthenticationPolicy", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "ValidatedAuthContext", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "TenantBinding", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "TenantResource", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "ProtocolLimits", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "InputShape", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "UploadLimits", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "ArchiveEntry", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "EgressPolicy", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "ValidatedOutboundTarget", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "OperationBinding", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "OperationReplayGuard", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AuthorityEpochGuard", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "SideEffectSafety", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "SecretString", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "SecurityEvent", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "SecurityErrorCode", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "SecurityMetric", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "SecurityPolicy", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "SecurityAsset", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AttackerClass", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "TrustBoundary", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "SECURITY_INVARIANTS", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "localhost", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "169, 254, 169, 254", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "is_private", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "is_unicast_link_local", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "revalidate_connection", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "UnsafeArchivePath", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "SymbolicLink", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "PayloadMismatch", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "AuthorityRollback", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "TwoPersonDestructiveApproval", paths: ["crates/aequora-security/src/lib.rs"]),
    Match(pattern: "from_validated_security", paths: ["crates/aequora-authority/src/executor/mod.rs"]),
    Match(pattern: "pub use aequora_security as security", paths: ["crates/aequora/src/lib.rs"]),
    Match(pattern: "Some\\(\"security\"\\)", paths: ["crates/aequora-cli/src/main.rs"]),
    Match(pattern: "\"aequora-security\"", paths: ["crates/aequora-dev/src/main.rs"]),
    Cargo(args: ["run", "-q", "-p", "aequora-cli", "--locked", "--", "security", "validate", "config/security.ron"], quiet: true),
]
