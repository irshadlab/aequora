[
    File("crates/aequora-registry/Cargo.toml"),
    File("crates/aequora-registry/src/registry.rs"),
    File("crates/aequora-cli/src/bin/aequora-registry.rs"),
    File("registry/manifest.ron"),
    File("registry/registry.lock"),
    File("docs/registry/generated-registry.md"),
    Directory("registry/core"),
    Directory("registry/app"),
    Directory("registry/extensions"),
    Match(pattern: "AEQ-INV-REGISTRY001", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-REGISTRY002", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-REGISTRY003", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-REGISTRY004", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-REGISTRY005", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-REGISTRY006", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-REGISTRY007", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-REGISTRY008", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-REGISTRY009", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "(^|[^[:alnum:]_-])(sqlx|stoolap|tokio|axum|quinn|reqwest)([^[:alnum:]_-]|$)", paths: ["crates/aequora-registry/Cargo.toml"], forbidden: true),
    Match(pattern: "Entity", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "Operation", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "Event", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "Field", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "Capability", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "ConsistencyProfile", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "Error", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "Job", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "Consumer", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "AuditAction", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "Migration", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "Protocol", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "Message", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "Permission", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "AdminAction", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "Reason", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "DecisionRule", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "ArtifactFormat", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "ConformanceProfile", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "ConformanceTest", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "CertificationTier", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "pub use aequora_registry as registry", paths: ["crates/aequora/src/lib.rs"]),
    Match(pattern: "durable_registry_provenance", paths: ["crates/aequora-diagnostics/src/lib.rs"]),
    Match(pattern: "cargo .*aequora-cli.*verify", paths: [".github/workflows/ci.yml"]),
    Cargo(args: ["run", "-q", "-p", "aequora-cli", "--locked", "--bin", "aequora-registry", "--", "verify", "."], quiet: true),
    Cargo(args: ["run", "-q", "-p", "aequora-cli", "--locked", "--bin", "aequora-registry", "--", "rust", ".", "--check"], quiet: true),
]
