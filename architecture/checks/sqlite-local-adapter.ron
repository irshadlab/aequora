    Match(pattern: "integrity_check", paths: ["crates/aequora-store-sqlite/src/lib.rs"]),
    Match(pattern: "rusqlite|aequora-store-sqlite", paths: ["crates/aequora-adapter-sdk/Cargo.toml", "crates/aequora-store/Cargo.toml"], forbidden: true),
    Match(pattern: "rusqlite::|SQLiteDatabase|SQLiteProjectionHook", paths: ["crates/aequora-adapter-sdk/src", "crates/aequora-store/src"], forbidden: true),
    Cargo(args: ["test", "-q", "-p", "aequora-store-sqlite", "--lib", "--locked", "--offline"]),
    Cargo(args: ["test", "-q", "-p", "aequora-types", "-p", "aequora-adapter-sdk", "--locked", "--offline"]),
    Cargo(args: ["test", "-q", "-p", "aequora", "--test", "adapter_manifests", "--features", "postgres,sqlite,stoolap", "--locked", "--offline"]),
    Cargo(args: ["run", "-q", "-p", "aequora-cli", "--offline", "--bin", "aequora-registry", "--", "verify", "."]),
]
