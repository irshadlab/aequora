    Match(pattern: "CREATE TABLE IF NOT EXISTS metadata", paths: ["crates/aequora-store-sqlite/src/lib.rs"]),
    Match(pattern: "journal_mode", paths: ["crates/aequora-store-sqlite/src/lib.rs", "crates/aequora-store-sqlite/src/config.rs"]),
    Match(pattern: "synchronous", paths: ["crates/aequora-store-sqlite/src/lib.rs", "crates/aequora-store-sqlite/src/config.rs"]),
