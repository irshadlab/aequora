[
    File("crates/aequora-adapter-sdk/Cargo.toml"),
    File("crates/aequora-adapter-sdk/src/certification/mod.rs"),
    File("crates/aequora-testkit/src/conformance.rs"),
    File("crates/aequora-testkit/tests/conformance_certification_contracts.rs"),
    File("registry/core/certification.ron"),
    File("conformance/fixtures/storage-core-passing-request.ron"),
    File("conformance/fixtures/failure-trace.ron"),
    File("ecosystem/catalog.ron"),
    File("docs/conformance-invariant-coverage.md"),
    File("config/certification.ron"),
    Match(pattern: "AEQ-INV-CERT001", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-CERT002", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-CERT003", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-CERT004", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-CERT005", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-CERT006", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-CERT007", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-CERT008", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "AEQ-INV-CERT009", paths: ["crates/aequora-types/src/invariants/mod.rs"]),
    Match(pattern: "ConformanceProfile", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "domain: ConformanceProfile", paths: ["registry/core/certification.ron"]),
    Match(pattern: "ConformanceTest", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "domain: ConformanceTest", paths: ["registry/core/certification.ron"]),
    Match(pattern: "CertificationTier", paths: ["crates/aequora-registry/src/types.rs"]),
    Match(pattern: "domain: CertificationTier", paths: ["registry/core/certification.ron"]),
    Match(pattern: "(^|[^[:alnum:]_-])(sqlx|stoolap|tokio|axum|quinn|reqwest)([^[:alnum:]_-]|$)", paths: ["crates/aequora-adapter-sdk/Cargo.toml"], forbidden: true),
    Match(pattern: "aequora conform run", paths: ["crates/aequora-cli/src/lib.rs"]),
    Match(pattern: "certification_readiness", paths: ["crates/aequora-config/src/lib.rs"]),
    Match(pattern: "conformance_certification_contracts", paths: [".github/workflows/ci.yml"]),
    Match(pattern: "adapter_contracts", paths: [".github/workflows/ci.yml"]),
    Cargo(args: ["test", "-q", "-p", "aequora-adapter-sdk", "--locked"]),
    Cargo(args: ["test", "-q", "-p", "aequora-testkit", "--test", "conformance_certification_contracts", "--locked"]),
    Cargo(args: ["run", "-q", "-p", "aequora-cli", "--locked", "--", "conform", "storage"], quiet: true),
    Cargo(args: ["run", "-q", "-p", "aequora-cli", "--locked", "--", "conform", "run", "conformance/fixtures/storage-core-passing-request.ron"], quiet: true),
]
