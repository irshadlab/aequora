[
    File("HARDENING.md"),
    File(".cargo/audit.toml"),
    File("docs/high-assurance-hardening-completion.md"),
    Match(pattern: "^unsafe_code = \"forbid\"", paths: ["Cargo.toml"]),
    Match(pattern: "^unwrap_used = \\{ level = \"deny\"", paths: ["Cargo.toml"]),
    Match(pattern: "^expect_used = \\{ level = \"deny\"", paths: ["Cargo.toml"]),
    PinnedActions,
    Match(pattern: "cargo-audit --version 0\\.22\\.2 --locked", paths: [".github/workflows/ci.yml"]),
    Match(pattern: "audit --file Cargo\\.lock", paths: [".github/workflows/ci.yml"]),
    Match(pattern: "audit --file fuzz/Cargo\\.lock", paths: [".github/workflows/ci.yml"]),
    Match(pattern: "RUSTSEC-2023-0071", paths: [".cargo/audit.toml"]),
    Match(pattern: "fn read_bounded\\(", paths: ["crates/aequora-cli/src/lib.rs"]),
    Match(pattern: "fn read_bounded_text\\(", paths: ["crates/aequora-dev/src/main.rs"]),
    Match(pattern: "MAX_REGISTRY_FILE_BYTES", paths: ["crates/aequora-registry/src/codegen.rs"]),
    Match(pattern: "redirect::Policy::none\\(\\)", paths: ["crates/aequora-http/src/lib.rs"]),
    Match(pattern: "coverage_and_future_suite_claims_cannot_be_resealed", paths: ["crates/aequora-adapter-sdk/src/certification/mod.rs"]),
    Match(pattern: "evidence_paths_and_policy_metadata_are_bounded", paths: ["crates/aequora-adapter-sdk/src/certification/mod.rs"]),
    Match(pattern: "AEQUORA_STRESS_AUTH_KEY_HEX", paths: ["crates/aequora/examples/support/stress_auth.rs"]),
    Match(pattern: "blake3::keyed_hash", paths: ["crates/aequora/examples/support/stress_auth.rs"]),
    Match(pattern: "constant_time_eq", paths: ["crates/aequora/examples/support/stress_auth.rs"]),
    Match(pattern: "task identity mismatch", paths: ["crates/aequora/examples/realworld_server.rs"]),
    Match(pattern: "with_graceful_shutdown", paths: ["crates/aequora/examples/realworld_server.rs"]),
    Match(pattern: "MAX_LATENCY_SAMPLES", paths: ["crates/aequora/examples/realworld_stress.rs"]),
    Match(pattern: "pending_outbox", paths: ["crates/aequora/examples/realworld_stress.rs"]),
    Match(pattern: "record_unhandled", paths: ["crates/aequora/examples/realworld_stress.rs"]),
    Match(pattern: "test-token|starts_with\\(\"bearer-\"\\)|TenantId::from_str\\(tenant_str\\)", paths: ["crates/aequora/examples"], forbidden: true),
    Match(pattern: "take\\(u64::try_from\\(MAX_SECRET_BYTES \\+ 1\\)", paths: ["crates/aequora-security/src/secrets/mod.rs"]),
    Match(pattern: "validate_secret_value", paths: ["crates/aequora-security/src/secrets/mod.rs"]),
    Match(pattern: "fs::read\\(path\\)", paths: ["crates/aequora-security/src/secrets/mod.rs"], forbidden: true),
    Match(pattern: "MAX_CONFIG_RON_BYTES", paths: ["crates/aequora-config/src/lib.rs"]),
    Match(pattern: "MAX_DEPLOYMENT_RON_BYTES", paths: ["crates/aequora-deployment/src/lib.rs"]),
    Match(pattern: "MAX_CATALOG_RON_BYTES", paths: ["crates/aequora-observability/src/part46.rs"]),
    Match(pattern: "MAX_MANIFEST_RON_BYTES", paths: ["crates/aequora-release/src/productization.rs"]),
    Match(pattern: "MAX_POLICY_RON_BYTES", paths: ["crates/aequora-supply-chain/src/lib.rs"]),
    Match(pattern: "^FROM [^[:space:]]+@sha256:[0-9a-f]{64}$", paths: ["deploy/container/realworld.Containerfile"]),
    Match(pattern: "^FROM .*:latest|image: .*:latest", paths: ["deploy"], forbidden: true),
    Match(pattern: "hostIP: 127\\.0\\.0\\.1", paths: ["deploy/kubernetes/realworld-k8s.yaml"]),
    Match(pattern: "automountServiceAccountToken: false", paths: ["deploy/kubernetes/realworld-k8s.yaml"]),
    Match(pattern: "readOnlyRootFilesystem: true", paths: ["deploy/kubernetes/realworld-k8s.yaml"]),
    Match(pattern: "drop: \\[\"ALL\"\\]", paths: ["deploy/kubernetes/realworld-k8s.yaml"]),
    Match(pattern: "terminationGracePeriodSeconds: 10", paths: ["deploy/kubernetes/realworld-k8s.yaml"]),
    Match(pattern: "sizeLimit: 64Mi", paths: ["deploy/kubernetes/realworld-k8s.yaml"]),
]
