(
    manifest: "deploy/kubernetes/realworld-k8s.yaml",
    container: "aequora-stress-harness-pod-aequora-api",
    executable: "target/release/examples/realworld_stress",
    endpoint: "http://127.0.0.1:8443",
    readiness_attempts: 30,
    readiness_delay_ms: 500,
    scenarios: [
        (name: "Load and contention", clients: 40, duration: 30, batch_size: 25, hot_keys: 8, adversarial_clients: 8),
        (name: "Pause and reconnect", clients: 40, duration: 25, batch_size: 20,
            disruption: Some(Pause(after_ms: 6000, duration_ms: 2500))),
        (name: "Restart in flight", clients: 40, duration: 25, batch_size: 20,
            disruption: Some(Restart(after_ms: 8000))),
    ],
)
